# Python bytecode and caches
__pycache__/
*.py[cod]

# Virtual environment
.venv/

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging
*.egg-info/

# Project runtime directories (keep the directory, ignore its generated contents)
logs/*
output/*

# Local Claude Code settings (machine-specific, never shared)
.claude/settings.local.json

# Input data (developer-owned study data, never versioned)
exemplo/
*.pdf

# Generated dashboards
/dashboard_dessem.html
/*.html

# Keep placeholder files that mark empty runtime directories as tracked
!**/.gitkeep
